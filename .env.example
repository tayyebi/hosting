# Connection strings for standalone / non-Docker runs against an external Postgres.
# When running via `compose.yaml`, PostgreSQL runs passwordless inside an isolated
# internal Docker network and these URLs are wired automatically.

# Runtime app role — RLS enforced. Used by normal request handlers.
DATABASE_URL=postgres://platform_app@localhost:5432/platform?sslmode=disable

# Admin role — runs migrations, seeds data, drives /s/database schema listing.
# Owner of all tables; effectively bypasses RLS.
DATABASE_URL_ADMIN=postgres://platform_admin@localhost:5432/platform?sslmode=disable

# Read-only role — used by the sysadmin SQL console so a typo in a DELETE
# or DROP can't hurt the database.
DATABASE_URL_READONLY=postgres://platform_readonly@localhost:5432/platform?sslmode=disable

# Connection pool sizing (per role).
DB_MAX_CONNS=25
DB_MIN_CONNS=2

# HTTP listen port (standalone PORT and compose.yaml host APP_PORT).
PORT=8021
APP_PORT=8021

# Initial System Super Administrator seeded by db.Seed() on first startup.
SYSADMIN_EMAIL=sysadmin@platform.io
SYSADMIN_NAME=System Administrator
SYSADMIN_PASSWORD=sysadmin123
