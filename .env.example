# Connection strings for the three Postgres roles.
# Copy this file to `.env` and adjust credentials for your environment.

# Runtime app role — RLS enforced. Used by normal request handlers.
DATABASE_URL=postgres://platform_app:app_dev_password@localhost:5432/platform?sslmode=disable

# Admin role — runs migrations, seeds data, drives /s/database schema listing.
# Owner of all tables; effectively bypasses RLS.
DATABASE_URL_ADMIN=postgres://platform_admin:admin_dev_password@localhost:5432/platform?sslmode=disable

# Read-only role — used by the sysadmin SQL console so a typo in a DELETE
# or DROP can't hurt the database.
DATABASE_URL_READONLY=postgres://platform_readonly:readonly_dev_password@localhost:5432/platform?sslmode=disable

# Connection pool sizing (per role).
DB_MAX_CONNS=25
DB_MIN_CONNS=2

# Passwords consumed by docker-compose.yml / scripts/db-init.sh.
PG_ADMIN_PASSWORD=admin_dev_password
PG_APP_PASSWORD=app_dev_password
PG_READONLY_PASSWORD=readonly_dev_password
